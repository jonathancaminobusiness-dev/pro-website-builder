{
  "name": "pro-website-builder",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "dev": "corepack pnpm --filter @pwb/server dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "run:fixture": "tsx scripts/run-fixture.ts",
    "typecheck": "tsc -b",
    "lint": "corepack pnpm typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
